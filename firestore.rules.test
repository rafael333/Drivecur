rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGRAS TEMPORÁRIAS PARA TESTE - PERMITEM TUDO
    // ⚠️ ATENÇÃO: Use apenas para testar! Depois volte para as regras seguras em firestore.rules
    
    // Permite leitura e escrita para usuários autenticados
    match /googleDriveTokens/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Permite acesso a outras coleções apenas para usuários autenticados (TEMPORÁRIO)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}










